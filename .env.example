# Public browser configuration. Never use a service_role/secret key in VITE_ variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Backend-only runtime settings for external integrations. NEVER prefix with VITE_.
# Copy values from the same Supabase project used above; do not commit real secrets.
VYON_SUPABASE_URL=
VYON_SUPABASE_SECRET_KEY=

# Root .env contains ONLY the two public VITE_* values above.
# VYON_* values belong in server runtime configuration, never in committed .env.
# Automatically injected SUPABASE_* variables are not used by Vyon.
